{
  "expo": {
    "name": "SubTrack",
    "slug": "subtrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/subtrack-app-icon-1024.png",
    "scheme": "subtrack",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.baptista00.subtrack"
    },
    "android": {
      "package": "com.baptista00.subtrack",
      "adaptiveIcon": {
        "backgroundColor": "#1B4D3E",
        "foregroundImage": "./assets/images/brand/subtrack-adaptive-foreground.png",
        "monochromeImage": "./assets/images/brand/subtrack-symbol-black.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/subtrack-launch-symbol.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B4D3E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87485960-61a1-4dc6-9682-bbd4a7a814ea"
      }
    },
    "owner": "00baptista"
  }
}
